# Cloudflare Pages Headers Configuration
# Security headers and caching rules

/*
  # Security Headers
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block

  # Content Security Policy (updated for Supabase + Google Drive + Media)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' *.cloudflare.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com; font-src 'self' fonts.gstatic.com; img-src 'self' data: blob: *.cloudinary.com *.supabase.co drive.google.com lh3.googleusercontent.com; media-src 'self' data: blob: cdn.pixabay.com; connect-src 'self' *.cloudflare.com *.supabase.co; frame-ancestors 'none';

  # Cache Control for static assets
  Cache-Control: public, max-age=31536000, immutable

# HTML files - no cache for dynamic content
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Assets with hash - long term cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images - moderate cache
/*.jpg
  Cache-Control: public, max-age=2592000
/*.jpeg
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000
/*.gif
  Cache-Control: public, max-age=2592000
/*.webp
  Cache-Control: public, max-age=2592000

# Fonts - long term cache
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable
/*.ttf
  Cache-Control: public, max-age=31536000, immutable
