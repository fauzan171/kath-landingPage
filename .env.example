# ============================================
# KATH Event Organizer - Environment Variables
# ============================================
# Architecture: Supabase + Google Drive + n8n (100% FREE)
# Total Cost: $0/month
# ============================================

# ============================================
# 1. SUPABASE CONFIGURATION
# ============================================
# Get these from: https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: Never expose service_role key in frontend!
# Only use anon key for client-side operations

# ============================================
# 2. N8N WEBHOOK CONFIGURATION
# ============================================
# Your n8n webhook base URL (where you deployed n8n)
# Options: Railway, Render, self-hosted, or n8n.cloud

VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook

# ============================================
# 3. GOOGLE DRIVE (Backend via n8n)
# ============================================
# These are configured in n8n, not here
# See: n8n/cibc-upload-workflow.json
# - Google Drive OAuth credentials (set in n8n)
# - Target folder ID for uploads

# ============================================
# 4. APP CONFIGURATION
# ============================================

VITE_APP_NAME=KATH Event Organizer
VITE_APP_URL=http://localhost:5173

# Contact Information (used across the app)
VITE_CONTACT_EMAIL=competition@kath.com
VITE_WHATSAPP_NUMBER=622112345678

# Optional: Enable mock data when backend not available
VITE_USE_MOCK_DATA=true

# ============================================
# 5. OPTIONAL: ANALYTICS & MONITORING
# ============================================

# VITE_GA_TRACKING_ID=G-XXXXXXXXXX
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file to .env
# 2. Replace placeholder values with your actual credentials
# 3. Never commit .env to version control
# 4. See SETUP.md for detailed setup instructions