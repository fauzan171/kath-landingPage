# ============================================
# KATH Event Organizer - Environment Variables
# ============================================
# Architecture: Supabase + Cloudflare R2 (100% FREE)
# Storage: Cloudflare R2 for photos and PDFs
# Total Cost: $0/month (Supabase Free + R2 Free Tier)
# ============================================

# ============================================
# 1. SUPABASE CONFIGURATION
# ============================================
# Get these from: https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: Never expose service_role key in frontend!
# Only use anon key for client-side operations

# ============================================
# 2. APP CONFIGURATION
# ============================================

VITE_APP_NAME=KATH Event Organizer
VITE_APP_URL=http://localhost:5173

# Contact Information (used across the app)
VITE_CONTACT_EMAIL=competition@kath.com
VITE_WHATSAPP_NUMBER=622112345678

# Optional: Enable mock data when backend not available
VITE_USE_MOCK_DATA=true

# ============================================
# 3. CLOUDFLARE R2 STORAGE (Backend via Supabase Edge Function)
# ============================================
# These are configured in Supabase Edge Function secrets, NOT here.
# Set them via: supabase secrets set
# - R2_ENDPOINT        (e.g., https://<account-id>.r2.cloudflarestorage.com)
# - R2_ACCESS_KEY_ID   (R2 API token)
# - R2_SECRET_ACCESS_KEY (R2 secret)
# - R2_BUCKET_NAME     (e.g., kath-events)
# - R2_PUBLIC_DOMAIN   (custom domain for public file access, e.g., files.kath.com)
#
# The upload flow:
# 1. Frontend calls Supabase Edge Function "upload-r2"
# 2. Edge Function generates a presigned PUT URL
# 3. Frontend uploads file directly to R2
# 4. File URL is stored in Supabase database

# ============================================
# 4. OPTIONAL: ANALYTICS & MONITORING
# ============================================

# VITE_GA_TRACKING_ID=G-XXXXXXXXXX
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file to .env
# 2. Replace placeholder values with your actual credentials
# 3. Never commit .env to version control
# 4. Set R2 secrets in Supabase: supabase secrets set R2_ENDPOINT=... R2_ACCESS_KEY_ID=...
# 5. See SETUP.md for detailed setup instructions
